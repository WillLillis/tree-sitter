# Query engine profiler. Run from the repo root:  make -C tools/query-profiler
#
# Builds against an instrumented copy of lib/src/query.c (generated by patch.py)
# so it can see TSQuery/TSQueryCursor internals, which are private to that file.

ROOT    := $(CURDIR)/../..
HERE    := tools/query-profiler
OUT     := $(ROOT)/target/query-profiler
INSTR   := $(ROOT)/$(HERE)/query_instr.c

# Grammars are gitignored fixtures; build against whichever are present.
GRAMMARS := javascript rust python go c
AVAIL    := $(foreach g,$(GRAMMARS),$(if $(wildcard $(ROOT)/test/fixtures/grammars/$(g)/src/parser.c),$(g)))
SRCS     := $(foreach g,$(AVAIL),$(ROOT)/test/fixtures/grammars/$(g)/src/parser.c) \
            $(foreach g,$(AVAIL),$(wildcard $(ROOT)/test/fixtures/grammars/$(g)/src/scanner.c))

# _DEFAULT_SOURCE (not _POSIX_C_SOURCE) — unicode.h needs le16toh/be16toh.
# -Ilib/src so the generated query_instr.c resolves its own "./alloc.h"-style includes.
CFLAGS  := -O2 -D_DEFAULT_SOURCE=1 -I$(ROOT)/lib/include -I$(ROOT)/lib/src -I$(ROOT) -Wno-unused-function
LANGDEF := $(foreach g,$(AVAIL),-DHAVE_$(shell echo $(g) | tr a-z A-Z))

.PHONY: all clean check bench joinproto
all: $(OUT)/qprobe $(OUT)/bugs $(OUT)/bench

$(INSTR): $(ROOT)/lib/src/query.c patch.py
	cd $(ROOT) && python3 $(HERE)/patch.py

$(OUT)/qprobe: main.c $(INSTR) | $(OUT)
	cd $(ROOT) && $(CC) $(CFLAGS) $(LANGDEF) -o $@ $(HERE)/main.c $(SRCS)

$(OUT)/bugs: bugs.c $(INSTR) | $(OUT)
	cd $(ROOT) && $(CC) $(CFLAGS) $(LANGDEF) -o $@ $(HERE)/bugs.c $(SRCS)

$(OUT):
	mkdir -p $(OUT)

check: all
	@echo "grammars available: $(AVAIL)"
	@$(OUT)/bugs

# Build only the uninstrumented timer -- useful for A/B'ing a query.c change,
# since it does not depend on patch.py's anchors still matching.
bench: $(OUT)/bench

# Structural-join prototype (throwaway; sizes the prize for the pathological pattern).
joinproto: $(OUT)/join_proto
$(OUT)/join_proto: join_proto.c $(ROOT)/lib/src/query.c | $(OUT)
	cd $(ROOT) && $(CC) $(CFLAGS) $(LANGDEF) -o $@ $(HERE)/join_proto.c $(SRCS)

clean:
	rm -rf $(OUT) $(INSTR)

# Uninstrumented A/B timer: links lib/src/query.c directly, no counters.
$(OUT)/bench: bench.c $(ROOT)/lib/src/query.c | $(OUT)
	cd $(ROOT) && $(CC) $(CFLAGS) $(LANGDEF) -o $@ $(HERE)/bench.c $(SRCS)
